-- Hàm biến đổi một bộ phận nhân vật thành khối xám trơn
local function GrayOutPart(part)
    pcall(function()
        if part:IsA("BasePart") then
            part.Material = Enum.Material.SmoothPlastic
            part.Color = Color3.fromRGB(120, 120, 120)
            
            local texture = part:FindFirstChildOfClass("Texture")
            if texture then texture:Destroy() end
        end
    end)
end

-- Hàm xóa toàn bộ vật phẩm trang trí trên nhân vật
local function StripCharacter(character)
    pcall(function()
        if not character:IsDescendantOf(game) then return end
        
        for _, obj in pairs(character:GetChildren()) do
            if obj:IsA("Clothing") or obj:IsA("ShirtGraphic") or obj:IsA("Accessory") or obj:IsA("CharacterMesh") then
                obj:Destroy()
            elseif obj:IsA("BasePart") then
                GrayOutPart(obj)
                if obj.Name == "Head" then
                    local face = obj:FindFirstChildOfClass("Decal")
                    if face then face:Destroy() end
                end
            end
        end
        
        character.ChildAdded:Connect(function(obj)
            task.wait()
            if obj:IsA("Clothing") or obj:IsA("ShirtGraphic") or obj:IsA("Accessory") or obj:IsA("CharacterMesh") then
                obj:Destroy()
            elseif obj:IsA("BasePart") then
                GrayOutPart(obj)
            end
        end)
    end)
end

-- Hàm tối ưu map
local function OptimizeMapPart(descendant)
    pcall(function()
        if descendant:IsA("BasePart") and not descendant:IsA("MeshPart") and not descendant:IsAncestorOf(game.Workspace) then
            if not descendant:FindFirstAncestorOfClass("Model") or not game:GetService("Players"):GetPlayerFromCharacter(descendant.Parent) then
                descendant.Material = Enum.Material.SmoothPlastic
            end
        elseif descendant:IsA("Decal") or descendant:IsA("Texture") then
            if not descendant:FindFirstAncestor("Humanoid") then
                descendant:Destroy()
            end
        elseif descendant:IsA("ParticleEmitter") or descendant:IsA("Trail") or descendant:IsA("Smoke") or descendant:IsA("Sparkles") then
            descendant.Enabled = false
        end
    end)
end

local function ActivateSuperFixLag()
    FixLagButton.Text = "ĐANG KHỬ SKIN..."
    FixLagButton.BackgroundColor3 = Color3.fromRGB(200, 200, 50)
    
    pcall(function()
        local Lighting = game:GetService("Lighting")
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 9e9
        for _, effect in pairs(Lighting:GetChildren()) do
            effect.Enabled = false
        end
    end)

    for _, player in pairs(game:GetService("Players"):GetPlayers()) do
        if player.Character then
            StripCharacter(player.Character)
        end
        player.CharacterAdded:Connect(StripCharacter)
    end
    
    game:GetService("Players").PlayerAdded:Connect(function(player)
        player.CharacterAdded:Connect(StripCharacter)
    end)

    task.spawn(function()
        local descendants = game:GetService("Workspace"):GetDescendants()
        for i, descendant in pairs(descendants) do
            OptimizeMapPart(descendant)
            if i % 300 == 0 then
                task.wait()
            end
        end
        
        FixLagButton.Text = "SIÊU MƯỢT ĐÃ BẬT!"
        FixLagButton.BackgroundColor3 = Color3.fromRGB(50, 150, 50)
    end)

    game:GetService("Workspace").DescendantAdded:Connect(OptimizeMapPart)
end

FixLagButton.MouseButton1Click:Connect(ActivateSuperFixLag)

